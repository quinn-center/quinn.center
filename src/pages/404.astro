---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <div class="container page-head">
    <h1>Page not found</h1>
    <p class="lede">There is nothing at this address. Try the <a href="/">home page</a>, the <a href="/blog/">blog</a>, or the <a href="/newsletter/">newsletter</a>.</p>
  </div>
  <div class="container page-body">
    <img src="/brand/quinn-cat.svg" alt="" width="93" height="120" />
  </div>
</Base>
