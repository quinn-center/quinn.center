// Cloudflare Workers, static assets only (no Worker code). Untested until the Cloudflare account
// is set up: `npm run build && npx wrangler deploy`, or connect the repository in the Cloudflare
// dashboard (Workers & Pages → Create → import the repository, build command `npm run build`,
// deploy command `npx wrangler deploy`). GitHub Pages ignores this file.
{
  "name": "quinn-center",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
